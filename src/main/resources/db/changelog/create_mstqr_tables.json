{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "create mstqr tables",
        "author": "Kareem Elzayat",
        "preConditions": [
          {
            "onFail": "MARK_RAN"
          },
          {
            "not": [
              {
                "tableExists": {
                  "tableName": "mstqr_user"
                }
              },
              {
                "tableExists": {
                  "tableName": "mstqr_host"
                }
              },
              {
                "tableExists": {
                  "tableName": "mstqr_token"
                }
              },
              {
                "tableExists": {
                  "tableName": "mstqr_user_mstqr_host"
                }
              },
              {
                "tableExists": {
                  "tableName": "mstqr_token_scns"
                }
              }
            ]
          }
        ],
        "changes": [
          {
            "createTable": {
              "tableName": "mstqr_user",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "UUID",
                    "constraints": {
                      "primaryKey": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "version",
                    "type": "BIGINT(20)",
                    "defaultValueNumeric": 0,
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "uid",
                    "type": "VARCHAR(28)",
                    "constraints": {
                      "unique": true,
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "role",
                    "type": "VARCHAR(50)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "last_updated",
                    "type": "TIMESTAMP",
                    "defaultValueComputed": "CURRENT_TIMESTAMP",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "date_created",
                    "type": "TIMESTAMP",
                    "defaultValueComputed": "CURRENT_TIMESTAMP",
                    "constraints": {
                      "nullable": false
                    }
                  }
                }
              ]
            }
          },
          {
            "createTable": {
              "tableName": "mstqr_host",
              "columns": [
                {
                  "column": {
                    "name": "id",
                    "type": "UUID",
                    "constraints": {
                      "primaryKey": true
                    }
                  }
                },
                {
                  "column": {
                    "name": "version",
                    "type": "BIGINT(20)",
                    "defaultValueNumeric": 0,
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "last_updated",
                    "type": "TIMESTAMP",
                    "defaultValueComputed": "CURRENT_TIMESTAMP",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "date_created",
                    "type": "TIMESTAMP",
                    "defaultValueComputed": "CURRENT_TIMESTAMP",
                    "constraints": {
                      "nullable": false
                    }
                  }
                },
                {
                  "column": {
                    "name": "name",
                    "type": "VARCHAR(255)",
                    "constraints": {
                      "nullable": false
                    }
                  }
                }
              ]
            }
          },
          {
            "createTable": {
              "tableName": "mstqr_token",
