                    }
                  }
                }
              ]
            }
          },
          {
            "createTable": {
              "tableName": "mstqr_user_mstqr_host",
              "columns": [
                {
                  "column": {
                    "name": "mstqr_user_id",
                    "type": "UUID",
                    "constraints": {
                      "nullable": false,
                      "foreignKeyName": "fk_mstqr_user_id",
                      "references": "mstqr_user (id)"
                    }
                  }
                },
                {
                  "column": {
                    "name": "mstqr_hosts_id",
                    "type": "UUID",
                    "constraints": {
                      "nullable": false,
                      "foreignKeyName": "fk_mstqr_host_id",
                      "references": "mstqr_host (id)"
                    }
                  }
                }
              ]
            }
          },
          {
            "createTable": {
              "tableName": "mstqr_token_scns",
