                {
                  "column": {
                    "name": "mstqr_token_jti",
                    "type": "UUID",
                    "constraints": {
                      "nullable": false,
                      "foreignKeyName": "mstqr_token_scns_mstqr_token_jti_fk",
                      "references": "mstqr_token (jti)"
                    }
                  }
                }
              ]
            }
          },
          {
            "addPrimaryKey": {
              "columnNames": "mstqr_user_id, mstqr_hosts_id",
              "constraintName": "pk_mstqr_user_mstqr_host",
              "tableName": "mstqr_user_mstqr_host"
